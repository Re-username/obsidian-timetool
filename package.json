{
  "name": "obsidian-timetool",
  "version": "1.0.0",
  "description": "Калькулятор времени и дат внутри Obsidian (разница, сдвиг, интервалы, отсчёт)",
  "main": "main.js",
  "scripts": { "build": "tsc -noEmit -skipLibCheck && esbuild main.ts --bundle --external:obsidian --format=cjs --target=es2020 --outfile=main.js" },
  "devDependencies": {
    "obsidian": "^1.8.7",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.0",
    "@types/node": "^22.0.0"
  }
}
